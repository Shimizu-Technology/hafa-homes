WEB_ORIGIN=http://localhost:5173
# Production may provide a comma-separated allowlist for all approved storefronts.
# WEB_ORIGINS=https://hafahomes.com,https://broker.example
# DATABASE_URL=postgresql://localhost/hafa_homes_development

# Local/legacy fallback only. Explicit unknown/inactive domains or native slugs still fail closed.
DEFAULT_BROKERAGE_SLUG=hafa-homes-demo
# Required only while running the PR #21 backfill with ambiguous legacy ownership.
# LEGACY_BROKERAGE_SLUG=hafa-homes-demo

# Clerk auth
CLERK_JWKS_URL=https://your-clerk-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://your-clerk-instance.clerk.accounts.dev
# Optional: use if your Clerk JWT template sets an audience.
# CLERK_AUDIENCE=hafa-homes-api
# Required for account deletion and optional fallback for fetching a user's email if the JWT has no email claim.
CLERK_SECRET_KEY=sk_test_xxx
# Production boot requires a public HTTPS CLERK_ISSUER and an sk_live_ secret.
# Remove CLERK_JWKS_URL in production unless it exactly matches the issuer-derived URL.
# Production also requires every WEB_ORIGINS/WEB_ORIGIN entry, plus FRONTEND_URL when set,
# to be a public HTTPS origin without a path, query, fragment, or embedded credentials.
PLATFORM_ADMIN_EMAIL=shimizutechnology@gmail.com

# Notifications
# Email notifications are disabled unless explicitly enabled to avoid accidental sends in local/dev.
EMAIL_NOTIFICATIONS_ENABLED=false
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL="Hafa Homes <noreply@your-domain.com>"
MAILER_FROM_EMAIL=noreply@your-domain.com
FRONTEND_URL=http://localhost:5173

# Production runs Solid Queue inside Puma by default. Leave this unset for that
# single-owner setup. Set it to false only when a separate `bin/jobs` process is
# running, and keep one queue process unless capacity measurements justify more.
# SOLID_QUEUE_IN_PUMA=true
JOB_CONCURRENCY=1

# Schedule `bin/rails privacy:prune_anonymous_intent` daily in production.
LEAD_INTENT_ANONYMOUS_RETENTION_DAYS=90

# SMS notifications require ClickSend credentials plus the live-send gate.
LIVE_SMS_ENABLED=false
CLICKSEND_USERNAME=your-clicksend-username
CLICKSEND_API_KEY=your-clicksend-api-key
CLICKSEND_SENDER_ID=HafaHomes
