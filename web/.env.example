VITE_API_URL=http://localhost:3000

# Required for the real interactive listing map.
# Create a public token in Mapbox and restrict it to the deployed domain when possible.
VITE_MAPBOX_TOKEN=

# Optional analytics/session replay. Keep disabled locally unless testing analytics.
VITE_PUBLIC_POSTHOG_ENABLED=false
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
