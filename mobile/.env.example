# Rails API used by the native app.
# iOS simulator can usually use localhost if the API is running locally.
# Android emulator typically needs http://10.0.2.2:3000.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Clerk auth. Required to enable mobile sign-in/sign-up.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Optional Clerk JWT template if configured for API calls later.
EXPO_PUBLIC_CLERK_JWT_TEMPLATE=

# Future native map token once Mapbox/React Native Maps decision is finalized.
EXPO_PUBLIC_MAPBOX_TOKEN=
